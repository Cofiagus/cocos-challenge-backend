# Dedicated PostgreSQL database for integration tests only.
# Local PostgreSQL is supported. Never point this at the application/production database.
TEST_DATABASE_URL=postgresql://<user>:***@<host>:5432/<test_database>?sslmode=require

# Los tests que leen/escriben `timestamp without time zone` asumen UTC
# (misma semántica que src/index.ts); fijarla evita que la suite dependa
# de la zona del host.
TZ=UTC
