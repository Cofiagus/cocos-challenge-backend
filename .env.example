# Runtime connection: set locally in .env or in the deployment secret manager.
# Replace every placeholder before starting the API. Never commit real credentials.
DATABASE_URL=postgresql://<user>:***@<host>:5432/<database>?sslmode=require
PORT=3000

# Pool de conexiones (src/lib/prisma-client.ts). OPCIONALES: si no se definen,
# rigen los defaults con los que la API ya venía funcionando. Se leen UNA vez,
# al crear el cliente (primer request). Cada una debe ser un entero positivo;
# un valor inválido (vacío, 0, negativo, decimal, con espacios) aborta con un
# error que nombra la variable — no cae al default en silencio.
#
# Conexiones simultáneas del pool (default 10). Súbelo si la instancia atiende
# más concurrencia; el techo real lo pone max_connections del servidor y las
# réplicas desplegadas.
# DATABASE_POOL_MAX=10
#
# Milisegundos máximos para obtener una conexión del pool (default 5000).
# Es lo que hace que un request falle rápido (503) en vez de colgarse cuando la
# base remota no responde.
# DATABASE_CONNECTION_TIMEOUT_MS=5000
#
# statement_timeout de PostgreSQL por sentencia, en milisegundos (default
# 15000). Una query que lo exceda se cancela (SQLSTATE 57014) y la API responde
# 503 reintentable en vez de retener la conexión y el advisory lock del usuario.
# DATABASE_STATEMENT_TIMEOUT_MS=15000

# La app lee `timestamp without time zone` (orders.datetime/filledAt) como UTC.
# src/index.ts fija TZ=UTC antes de cargar cualquier módulo; se declara acá
# para que runners que no pasen por ese entry usen la misma semántica.
TZ=UTC
