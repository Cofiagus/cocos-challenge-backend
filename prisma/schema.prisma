// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String?  @unique
  accountNumber String?  @unique
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Instrument {
  id       Int      @id @default(autoincrement())
  ticker   String?  @unique
  name     String?
  type     String?
  orders   Order[]
  marketData MarketData[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("instruments")
}

model Order {
  id           Int       @id @default(autoincrement())
  instrumentId  Int
  userId       Int
  size         Int
  price        Decimal   @db.Decimal(10, 2)
  type         String    // MARKET, LIMIT
  side         String    // BUY, SELL, CASH_IN, CASH_OUT
  status       String    // NEW, FILLED, CANCELLED
  datetime     DateTime  @default(now())
  
  instrument   Instrument @relation(fields: [instrumentId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@map("orders")
}

model MarketData {
  id         Int      @id @default(autoincrement())
  instrumentId Int
  high       Decimal  @db.Decimal(10, 2)
  low        Decimal  @db.Decimal(10, 2)
  open       Decimal  @db.Decimal(10, 2)
  close      Decimal  @db.Decimal(10, 2)
  previousClose Decimal @db.Decimal(10, 2)
  date       DateTime
  
  instrument Instrument @relation(fields: [instrumentId], references: [id])

  @@map("marketdata")
  @@unique([instrumentId, date])
}